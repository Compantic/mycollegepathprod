rules_version = '2';
// Firebase Storage kuralları: kullanıcı sadece kendi profil fotoğrafını yükleyebilir / okuyabilir.
service firebase.storage {
  match /b/{bucket}/o {

    // users/{userId}/profile.* — sadece kendi klasörüne yazma, herkes (veya sadece kendi) okuyabilir
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
