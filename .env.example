# MyCollegePath – copy to .env.local and fill in values. Do not commit .env.local.
#
# Required for local auth + API routes: Firebase client + Admin credentials + OPENAI + Scorecard.
# Required for billing: STRIPE_SECRET_KEY (+ STRIPE_WEBHOOK_SECRET for webhooks).

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Analytics (optional; public)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-D4R6MBJ5KB
NEXT_PUBLIC_GTM_ID=GTM-WG92MDJG

# ---------------------------------------------------------------------------
# Firebase – client (public, safe in browser)
# Firebase Console → Project settings → General → Your apps
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin – server only (never expose to client)
# Resolution order in lib/firebase/admin.ts:
#   1) FIREBASE_SERVICE_ACCOUNT_BASE64
#   2) FIREBASE_SERVICE_ACCOUNT_JSON
#   3) FIREBASE_ADMIN_PROJECT_ID + FIREBASE_ADMIN_CLIENT_EMAIL + FIREBASE_ADMIN_PRIVATE_KEY
#   4) Local file serviceAccountKey.json (development only; do not commit)
# ---------------------------------------------------------------------------

# Option A (recommended for Vercel / Container Apps): base64 of the full service account JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option B: full service account JSON as a single line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# Option C: individual fields (also supported)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste private_key from the JSON; use \n for newlines in hosted env UIs
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Stripe – server only (required for checkout, portal, webhooks)
# Dashboard → Developers → API keys / Webhooks
# Use sk_test_... locally; sk_live_... in production.
# Enable Customer Portal in Stripe Dashboard for cancel / card update.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# OpenAI – server only (chat, matching, essays, roadmap, AI score)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional model overrides (fallback chain exists in lib/ai/openai.ts)
# OPENAI_MODEL=gpt-5.5
# OPENAI_CHAT_MODEL=gpt-5.5
# OPENAI_MATCHING_MODEL=gpt-5.5
# OPENAI_SCORE_MODEL=gpt-5.5

# ---------------------------------------------------------------------------
# College Scorecard – server only (college search / matching candidates)
# https://api.data.gov/signup/ — either name works
# ---------------------------------------------------------------------------
COLLEGE_SCORECARD_API_KEY=
# SCORECARD_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# UNSPLASH_ACCESS_KEY=
