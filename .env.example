# MyCollegePath – copy to .env.local and fill in values. Do not commit .env.local.

# App (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase – client (public, safe in browser)
# Get these from Firebase Console → Project settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin – server only (never expose to client)
# Option A: Individual vars (e.g. Vercel). Get from Firebase Console → Project settings → Service accounts → Generate new private key.
# For FIREBASE_ADMIN_PRIVATE_KEY paste the "private_key" value; in Vercel you can paste as-is (newlines as \n).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Option B: Full JSON as a single line (alternative to Option A)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# API keys – server only
OPENAI_API_KEY=
COLLEGE_SCORECARD_API_KEY=
# Optional: for college detail hero images (Unsplash). Get from https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=
